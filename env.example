# Copy this file to ".env" and fill in your keys. Never commit .env to Git.

# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Public Stable Diffusion models work without a token.
HF_API_KEY=your-huggingface-api-key-here

# "diffusers" = real Stable Diffusion (slow on CPU, ~4 GB first download)
# "placeholder" = instant fake images, great for testing the app end-to-end
IMAGE_BACKEND=diffusers

# Optional overrides (defaults shown).
# Gemini models are tried in order; if one is overloaded (503) or retired (404) the next is used.
# GEMINI_FLASH_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash
# GEMINI_PRO_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# GEMINI_MAX_RETRIES=2            # attempts per model before moving to the next
# GEMINI_CHAIN_PASSES=2           # full sweeps over the list before giving up
# GEMINI_COOLDOWN_SECONDS=60      # skip a model this long after it says "high demand"
# SD_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
# SD_STEPS=0
# SD_SIZE=512
